```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Test coverage
coverage/

# Build output
dist/
build/

# Temporary files
tmp/
temp/
*.tmp
*.swp
.DS_Store

# IDE and editor settings
.vscode/
.idea/

# Test environment
.env.test

# Uploaded files (if stored locally)
uploads/

# Debug output
*.stackdump
